{
  "name": "codexly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --pretty false",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:node",
    "lint": "eslint src electron vite.config.ts vitest.config.ts playwright.config.ts --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "build": "vite build",
    "prepare:codex": "node scripts/prepare-codex.mjs",
    "pack": "pnpm verify && pnpm prepare:codex && electron-builder --dir",
    "dist": "pnpm verify && pnpm prepare:codex && electron-builder",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@openai/codex": "0.144.5",
    "ai": "7.0.31",
    "ai-sdk-provider-codex-cli": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "radix-ui": "1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "42.7.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "26.1.0",
    "react-doctor": "^0.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "main": "dist-electron/main.js"
}
